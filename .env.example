# SQLite DB 파일 경로 (기본값: data/ledger.db)
DB_PATH=data/ledger.db

# 3단계(OCR)/4단계(AI 분류) 이후 사용
ANTHROPIC_API_KEY=

# 6단계 이후 사용 (카카오 메시지 API - 나에게 보내기)
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:8501
# 카카오 콘솔에서 "카카오 로그인" 클라이언트 시크릿을 활성화한 경우에만 입력 (앱 설정 > 앱 > 플랫폼 키 > REST API 키 수정)
KAKAO_CLIENT_SECRET=
